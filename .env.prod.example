# =============================================================
# .env.prod.example — Production secrets template
# ─────────────────────────────────────────────────────────────
# Copy this to .env on the production server and fill in real
# values. DO NOT commit .env to version control.
#
# Generate the JWT secret:
#   openssl rand -base64 48
#
# Generate the Postgres password:
#   openssl rand -base64 24
# =============================================================

# ── JWT ──────────────────────────────────────────────────────
# Shared secret for token signing (must be identical in all services).
JWT_SECRET=<REPLACE_WITH_BASE64_SECRET>
# Token lifetime (milliseconds). Default 1 hour.
JWT_EXPIRATION_MS=3600000

# ── PostgreSQL ───────────────────────────────────────────────
# Shared Postgres superuser credentials used by every service that
# touches the database (init scripts, Spring datasources, ml-service).
POSTGRES_USER=smart_traffic
POSTGRES_PASSWORD=<REPLACE_WITH_BASE64_SECRET>

# ── TomTom Traffic API (optional) ────────────────────────────
# Without a valid key the ingestion scheduler simply no-ops.
# Get one free at https://developer.tomtom.com/
TOMTOM_API_KEY=<REPLACE_WITH_YOUR_KEY>

# ── Public entry-point ports ─────────────────────────────────
# Frontend (nginx) — the only port browsers need.
FRONTEND_PORT=80
# API gateway direct access — useful for non-browser clients
# (health checks, webhooks, Grafana data sources).
GATEWAY_PORT=8080
